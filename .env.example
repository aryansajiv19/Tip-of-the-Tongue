PORT=3000

# Optional: server-side speech-to-text with real word timings (browser speech used if empty)
DEEPGRAM_API_KEY=
# Deepgram tells the voices apart so only your own pauses trigger a suggestion; set 0 to turn that off
DEEPGRAM_DIARIZE=

# Optional: real guessing (mock guesser used if empty)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
# A stronger model asked once, within 2 s, on a confirmed stall where the main model abstains or is
# unsure. It counts toward the call cap. Empty turns it off.
ANTHROPIC_ESCALATE_MODEL=claude-sonnet-5-5

# Browser origins allowed to open the WebSocket, comma-separated
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Packaging (all optional; with none set the dev setup is unchanged)
# Serve a built web folder (web/dist) on the same port, index.html at /
WEB_DIST=
# A WebSocket must open with ?token=<this>, otherwise it is closed with code 4401
TOTT_TOKEN=
# Append the log to this file instead of stdout (info level never contains words)
LOG_FILE=
# Local debugging only: append a JSONL trace of each session (words, detector, pace, guesses, gate)
# to this file. It CONTAINS WHAT WAS SAID. Leave empty to keep it off.
TRACE_FILE=

# Tuning
STUCK_PAUSE_MS=1500
GATE_MIN_CONFIDENCE=0.6
GUESS_TIMEOUT_MS=2500
# Start guessing early, after this much silence, so the pop-up is instant. 0 = off.
# Costs one extra Claude call per pause that turns out not to be a stall.
SPECULATE_AFTER_MS=300

# Optional personal profile, e.g. data/profiles/example.json (path relative to server/)
PROFILE_PATH=
