{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    // Electron's main process is CommonJS, which verbatimModuleSyntax does not allow.
    "verbatimModuleSyntax": false,
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2023"],
    "types": ["node"],
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
