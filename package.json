{
  "name": "tip-of-the-tongue",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "server",
    "web",
    "eval",
    "app"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm run dev -w server\" \"npm run dev -w web\"",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "npm run typecheck --workspaces",
    "test": "vitest run",
    "build": "npm run build --workspaces",
    "e2e": "playwright test -c e2e/playwright.config.ts",
    "eval": "npm run eval -w eval --",
    "e2e:live": "playwright test -c e2e/live/playwright.live.config.ts",
    "app": "npm run start -w app",
    "scenarios:live": "npm run scenarios:live -w eval --",
    "dist": "npm run build -w web -w server && node scripts/bundle-server.mjs && npm run dist -w app"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
